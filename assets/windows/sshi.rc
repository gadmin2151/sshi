#pragma code_page(65001)
#include <windows.h>

1 ICON "sshi.ico"
1 RT_MANIFEST "sshi.manifest"

1 VERSIONINFO
FILEVERSION SSHI_VERSION_NUM
PRODUCTVERSION SSHI_VERSION_NUM
FILEOS VOS_NT_WINDOWS32
FILETYPE VFT_APP
BEGIN
    BLOCK "StringFileInfo"
    BEGIN
        BLOCK "040904b0"
        BEGIN
            VALUE "FileDescription", "SSHI connections"
            VALUE "FileVersion", SSHI_VERSION_STR
            VALUE "ProductName", "SSHI"
            VALUE "ProductVersion", SSHI_VERSION_STR
        END
    END
    BLOCK "VarFileInfo"
    BEGIN
        VALUE "Translation", 0x0409, 1200
    END
END

3 MENU
BEGIN
    POPUP "&Подключения"
    BEGIN
        MENUITEM "&Новое подключение", 102
        MENUITEM SEPARATOR
        MENUITEM "Сохранить резервную &копию…", 112
        MENUITEM "&Восстановить из копии…", 113
    END
    POPUP "&Настройки"
    BEGIN
        POPUP "&Язык"
        BEGIN
            MENUITEM "Русский", 116
            MENUITEM "English", 117
        END
        MENUITEM SEPARATOR
        MENUITEM "Что нового", 118
    END
END

2 DIALOGEX 0, 0, 344, 79
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "Создано приглашение"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "Код действует 10 минут.", 2003, 12, 11, 320, 12
    EDITTEXT 2001, 12, 28, 320, 15, ES_READONLY | ES_AUTOHSCROLL
    PUSHBUTTON "Копировать код", 2002, 168, 53, 101, 15
    DEFPUSHBUTTON "Закрыть", IDOK, 276, 53, 56, 15
END

4 DIALOGEX 0, 0, 388, 278
STYLE DS_SETFONT | DS_MODALFRAME | DS_CENTER | WS_POPUP | WS_CAPTION | WS_SYSMENU
CAPTION "SSHI"
FONT 9, "Segoe UI"
BEGIN
    LTEXT "", 2110, 12, 10, 364, 11
    COMBOBOX 2101, 12, 24, 364, 70, CBS_DROPDOWNLIST | WS_VSCROLL | WS_TABSTOP
    CONTROL "", 2102, "Static", SS_OWNERDRAW, 12, 49, 364, 39
    CTEXT "", 2111, 12, 90, 116, 11, SS_ENDELLIPSIS
    CTEXT "SSH / Iroh", -1, 135, 90, 118, 11
    CTEXT "", 2112, 260, 90, 116, 11, SS_ENDELLIPSIS
    LTEXT "", 2113, 12, 113, 280, 11
    LTEXT "", 2114, 306, 113, 70, 11
    EDITTEXT 2103, 12, 126, 285, 16, ES_AUTOHSCROLL
    EDITTEXT 2104, 306, 126, 70, 16, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "", 2115, 12, 152, 280, 11
    LTEXT "", 2116, 306, 152, 70, 11
    EDITTEXT 2105, 12, 165, 285, 16, ES_AUTOHSCROLL
    EDITTEXT 2106, 306, 165, 70, 16, ES_AUTOHSCROLL | ES_NUMBER
    LTEXT "", 2107, 12, 194, 364, 40, SS_NOPREFIX
    DEFPUSHBUTTON "", IDOK, 214, 250, 99, 17
    PUSHBUTTON "", IDCANCEL, 320, 250, 56, 17
END
