def read_language():
    try:
        return "en" if LANGUAGE_FILE.read_text(encoding="utf-8").strip() == "en" else "ru"
    except (OSError, UnicodeError):
        return "ru"


def apply_gtk_language(value):
    # GTK's own dialogs and accessible stock controls use gettext.
    os.environ["LANGUAGE"] = value
    old = locale.setlocale(locale.LC_MESSAGES)
    locale.setlocale(locale.LC_MESSAGES, "C")
    for candidate in ("ru_RU.UTF-8" if value == "ru" else "en_US.UTF-8", "", "en_US.UTF-8", old):
        try:
            loc = locale.setlocale(locale.LC_MESSAGES, candidate)
            if loc.split(".")[0] not in ("C", "POSIX"):
                break
        except locale.Error:
            continue


def save_language(value):
    global language
    LANGUAGE_FILE.parent.mkdir(mode=0o700, parents=True, exist_ok=True)
    with tempfile.NamedTemporaryFile(dir=LANGUAGE_FILE.parent, delete=False) as file:
        try:
            file.write((value + "\n").encode("ascii"))
            file.flush()
            os.replace(file.name, LANGUAGE_FILE)
        finally:
            if os.path.exists(file.name):
                os.unlink(file.name)
    language = value
    apply_gtk_language(value)


language = read_language()
apply_gtk_language(language)


