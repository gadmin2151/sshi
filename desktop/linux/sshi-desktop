        panels = Gtk.Paned.new(Gtk.Orientation.HORIZONTAL)
        self.panes = {
            "local": FilePane(self, "local", tr("Этот компьютер", "This computer")),
            "remote": FilePane(self, "remote", profile["name"]),
        }
        panels.pack1(self.panes["local"].widget, True, False)
        panels.pack2(self.panes["remote"].widget, True, False)
        panels.set_position(488)
        body.pack_start(panels, True, True, 0)
        footer = styled(box(True, 4), "file-footer")
        self.status = label("", wrap=True)
        self.status.set_selectable(True)
        self.progress_bar = Gtk.ProgressBar()
        self.progress_bar.set_no_show_all(True)
        footer.pack_start(self.progress_bar, False, False, 0)
        footer.add(self.status)
        body.pack_start(footer, False, False, 0)
        self.connect("delete-event", lambda *_: self.busy)
        self.connect("destroy", self.close_worker)
        self.widgets_ready = True
        self.controls()
        self.show_all()
        self.browse("local", "", on_done=lambda: self.browse("remote", ""))

    def controls(self):
        if not self.widgets_ready:
            return
        local, remote = self.panes["local"], self.panes["remote"]
        self.upload.set_sensitive(not self.busy and remote.path is not None and bool(local.selected()))
        self.download.set_sensitive(not self.busy and local.path is not None and bool(remote.selected()))
        self.sign_in_button.set_sensitive(not self.busy)
        for pane in self.panes.values():
            pane.widget.set_sensitive(not self.busy)
            pane.up.set_sensitive(not self.busy and pane.parent is not None)

    def sign_in(self):
        self.owner.safe(lambda: self.owner.control_socket(self.profile))
        if not self.closing:
            self.browse("remote", self.panes["remote"].path or "", reconnect=True)

    def request(self, request, working, on_done=None, finished_message=None):
        if self.busy or self.closing:
            return False
        self.busy = True
        self.status.set_text(working)
        self.controls()
        if request["action"] == "copy":
            self.progress_bar.set_fraction(0)
            self.progress_bar.show()

        def work():
            if self.worker is None or self.worker.poll() is not None:
                self.worker = subprocess.Popen(
                    [SSHI, "__files", "--", self.profile["name"]],
                    stdin=subprocess.PIPE, stdout=subprocess.PIPE, stderr=subprocess.DEVNULL,
                    text=True, encoding="utf-8",
                )
            self.worker.stdin.write(json.dumps(request, ensure_ascii=False) + "\n")
            self.worker.stdin.flush()
            for line in self.worker.stdout:
                event = json.loads(line)
                if event["type"] == "progress":
                    GLib.idle_add(self.progress, event["progress"])
                else:
                    return event
            raise ValueError(tr("Сеанс передачи завершился. Попробуйте обновить панель.", "The file session closed. Try refreshing the pane."))

        def result(event, error):
            if self.closing:
                return
            self.busy = False
            self.progress_bar.hide()
            if not error and event["type"] == "error":
                error = event["message"]
            if error:
                self.status.set_text(error)
            elif event["type"] == "listing":
                self.panes[event["listing"]["side"]].replace(event["listing"])
                self.status.set_text(finished_message or tr("Готово", "Ready"))
            elif event["type"] == "copied":
                self.status.set_text(tr("Скопировано файлов: {}", "Files copied: {}").format(event["files"]))
            self.controls()
            if on_done and (not error or request["side"] == "local" and request["action"] == "list"):
                on_done()

        background(work, result)
        return True

    def browse(self, side, path, reconnect=False, on_done=None, finished_message=None):
        if path is None:
            return
        title = tr("Подключаемся к удалённой машине…", "Connecting to the remote computer…") if (
            side == "remote" and (self.panes[side].path is None or reconnect)
        ) else tr("Открываем папку…", "Opening folder…")
        self.request({"action": "list", "side": side, "path": path, "reconnect": reconnect},
                     title, on_done=on_done, finished_message=finished_message)

    def copy(self, side, names=None):
        other = "remote" if side == "local" else "local"
        source, dest = self.panes[side], self.panes[other]
        names = names if names is not None else source.selected()
        if not source.path or not dest.path or not names or not all(
            name in source.entries and source.entries[name]["kind"] in ("file", "directory") for name in names
        ):
            return False
        return self.request({"action": "copy", "side": side, "source": source.path,
                             "destination": dest.path, "names": names},
                            tr("Передаём файлы…", "Transferring files…"),
                            on_done=lambda: self.browse(other, dest.path, finished_message=self.status.get_text()))

    def progress(self, progress):
        if self.closing or not self.busy:
            return
        bytes_done, total = progress["bytes"], progress["total"]
        if total:
            self.progress_bar.set_fraction(min(bytes_done / total, 1))
        else:
            self.progress_bar.pulse()
        self.status.set_text(f'{FilePane.visible(progress["name"])} · {GLib.format_size(bytes_done)}')

    def drop(self, _tree, context, _x, _y, data, _info, time, target):
        source = "local" if target == "remote" else "remote"
        success = False
        if Gtk.drag_get_source_widget(context) == self.panes[source].tree:
            try:
                names = json.loads(data.get_data())
                success = isinstance(names, list) and all(isinstance(name, str) for name in names) and self.copy(source, names)
            except (TypeError, ValueError):
                pass
        Gtk.drag_finish(context, success, False, time)

    def close_worker(self, *_args):
        self.closing = True
        if self.worker is not None:
            self.worker.stdin.close()

