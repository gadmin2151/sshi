    def copy(self, value):
        clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
        clipboard.set_text(value, -1)
        clipboard.store()
        self.feedback.set_text(tr("Скопировано.", "Copied."))

    def buttons(self):
        self.start_button.set_sensitive(not self.checking and not self.active and self.report is None)
        self.stop_button.set_sensitive(not self.checking and self.active)
        self.check_button.set_sensitive(not self.checking)

    def show_error(self, summary, detail):
        self.status.set_text(summary)
        self.errors[self.path] = detail
        self.detail_text.set_text(detail)
        self.details.set_expanded(True)
        self.details.show()

    def end_monitor(self):
        if self.timer:
            GLib.source_remove(self.timer)
            self.timer = 0
        if self.report:
            self.report.cleanup()
            self.report = None

    def dispose(self, *_):
        self.disposed = True
        self.end_monitor()

    def start(self):
        if self.report or self.checking or self.active:
            return
        try:
            self.report = tempfile.TemporaryDirectory(prefix="sshi-start-")
            self.started_at = time.monotonic()
            self.final_check = False
            self.details.set_expanded(False)
            self.launcher = open_terminal(["socket", "start", "--", self.name], False, self.report.name)
            self.status.set_text(tr("Запускаем SSH в терминале…", "Starting SSH in the terminal…"))
            self.timer = GLib.timeout_add_seconds(1, self.poll)
            self.check()
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            self.end_monitor()
            self.show_error(tr("Не удалось открыть терминал.", "Could not open the terminal."), str(error))
            self.buttons()

    def poll(self):
        if not self.disposed and self.report:
            self.check()
        return GLib.SOURCE_CONTINUE if self.timer else GLib.SOURCE_REMOVE

    def start_result(self):
        directory = Path(self.report.name)
        try:
            return json.loads((directory / "result.json").read_text(encoding="utf-8"))
        except FileNotFoundError:
            pass
        marker = directory / "started"
        if marker.exists():
            pid = marker.read_text().strip()
            if pid:
                try:
                    os.kill(int(pid), 0)
                except ProcessLookupError:
                    # It may have published its result between our two reads.
                    result = directory / "result.json"
                    if result.exists():
                        return json.loads(result.read_text())
                    return 1, tr("Окно терминала закрылось до завершения SSH.", "The terminal closed before SSH finished.")
            return None
        if self.launcher.poll() not in (None, 0) or time.monotonic() - self.started_at >= 15:
            return 1, tr("Терминал не запустил команду SSHI.", "The terminal did not start the SSHI command.")
        return None

    def confirm_stop(self):
        prompt = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.NONE,
                                   message_type=Gtk.MessageType.QUESTION,
                                   text=tr("Остановить SSH-сокет?", "Stop this SSH control socket?"))
        prompt.format_secondary_text(tr("Сеансы, использующие этот сокет, будут закрыты.",
                                        "Sessions using this socket will disconnect."))
        prompt.add_buttons(tr("Отмена", "Cancel"), Gtk.ResponseType.CANCEL,
                           tr("Остановить", "Stop"), Gtk.ResponseType.OK)
        accepted = prompt.run() == Gtk.ResponseType.OK
        prompt.destroy()
        if accepted:
            self.check("close")

    def check(self, operation="check"):
        if self.checking or self.disposed:
            return
        self.checking = True
        self.buttons()
        def finished(_, error):
            if self.disposed:
                return
            self.checking = False
            self.active = not error and operation == "check"
            stopped = error and "no active ssh control socket" in error.lower()
            if self.active:
                self.end_monitor()
                self.status.set_text(tr("Сокет готов. Нажмите «Скопировать команду» для Codex или другого терминала.",
                                        "The socket is ready. Select Copy command for Codex or another terminal."))
            elif self.report:
                self.update_start(error if not stopped else None)
            elif error and not stopped:
                self.show_error(tr("Не удалось проверить сокет.", "Could not check the socket.") if operation == "check" else
                                tr("Не удалось остановить сокет.", "Could not stop the socket."), error)
            else:
                self.status.set_text(tr("Сокет не запущен.", "The socket is stopped."))
            self.buttons()
        background(lambda: cli("socket", operation, "--", self.name), finished)

    def update_start(self, check_error):
        try:
            result = self.start_result()
        except (OSError, ValueError) as error:
            result = 1, str(error)
        if result is not None:
            code, detail = result
            if code == 0 and not self.final_check:
                # The poll may have observed a missing socket just before the
                # terminal finished authentication. Confirm once after success.
                self.final_check = True
                GLib.idle_add(self.check)
                return
            self.end_monitor()
            summary = (tr("SSH завершился с кодом {}.", "SSH exited with status {}.").format(code) if code else
                       tr("SSH завершил запуск, но сокет недоступен.", "SSH finished starting, but the socket is unavailable."))
            self.show_error(summary, detail or check_error or summary)
        elif time.monotonic() - self.started_at >= 180:
            if self.timer:
                GLib.source_remove(self.timer)
                self.timer = 0
            self.status.set_text(tr("Завершите вход в терминале и нажмите «Проверить».",
                                    "Finish signing in through the terminal, then select Check status."))
        else:
            self.status.set_text(tr("Ожидаем SSH. Если терминал запросит пароль, введите его там.",
                                    "Waiting for SSH. If the terminal asks for a password, enter it there."))


class FilePane:
    def __init__(self, window, side, title):
        self.side = side
        self.path = None
        self.parent = None
        self.entries = {}
        self.widget = styled(box(True, 0), "file-pane")
        bar = styled(box(True, 7), "file-pane-bar")
        self.widget.pack_start(bar, False, False, 0)
        bar.add(label(title, "sshi-section", "file-pane-title"))
        row = box(False, 5)
        self.path_field = Gtk.Entry()
        self.path_field.set_placeholder_text(tr("Путь к папке", "Folder path"))
        self.path_field.get_accessible().set_name(title)
        self.path_field.connect("activate", lambda entry: window.browse(side, entry.get_text()))
        self.up = action("", lambda: window.browse(side, self.parent), "go-up-symbolic")
        self.up.set_tooltip_text(tr("На уровень выше", "Parent folder"))
        refresh = action("", lambda: window.browse(side, self.path or "", reconnect=side == "remote"),
                         "view-refresh-symbolic")
        refresh.set_tooltip_text(tr("Обновить", "Refresh"))
        row.pack_start(self.up, False, False, 0)
        row.pack_start(self.path_field, True, True, 0)
        row.pack_start(refresh, False, False, 0)
        bar.add(row)
        self.rows = Gtk.ListStore(str, str, str, str, str)
        self.tree = Gtk.TreeView(model=self.rows)
        self.tree.set_enable_search(True)
        self.tree.set_search_column(1)
        self.tree.get_selection().set_mode(Gtk.SelectionMode.MULTIPLE)
        self.tree.get_selection().connect("changed", lambda *_: window.controls())
        name = Gtk.TreeViewColumn(tr("Имя", "Name"))
        name.pack_start(icon := Gtk.CellRendererPixbuf(), False)
        name.add_attribute(icon, "icon-name", 0)
        name.pack_start(text := Gtk.CellRendererText(), True)
        name.add_attribute(text, "text", 1)
        name.set_expand(True)
        name.set_resizable(True)
        self.tree.append_column(name)
        size = Gtk.CellRendererText(xalign=1)
        self.tree.append_column(Gtk.TreeViewColumn(tr("Размер", "Size"), size, text=2))
        self.tree.connect("row-activated", lambda _tree, path, _column: self.open(window, path))
        scroll = Gtk.ScrolledWindow()
        scroll.set_policy(Gtk.PolicyType.AUTOMATIC, Gtk.PolicyType.AUTOMATIC)
        scroll.add(self.tree)
        self.widget.pack_start(scroll, True, True, 0)
        target = [Gtk.TargetEntry.new("application/x-sshi-pane-selection", Gtk.TargetFlags.SAME_APP, 1)]
        self.tree.drag_source_set(Gdk.ModifierType.BUTTON1_MASK, target, Gdk.DragAction.COPY)
        self.tree.drag_dest_set(Gtk.DestDefaults.ALL, target, Gdk.DragAction.COPY)
        self.tree.connect("drag-data-get", self.drag_data)
        self.tree.connect("drag-data-received", window.drop, side)

    def replace(self, listing):
        self.path = listing["path"]
        self.parent = listing["parent"]
        self.path_field.set_text(self.path)
        self.rows.clear()
        self.entries = {entry["name"]: entry for entry in listing["entries"]}
        for entry in self.entries.values():
            kind, name, size = entry["kind"], entry["name"], entry["size"]
            icon = {"directory": "folder-symbolic", "file": "text-x-generic-symbolic"}.get(kind, "emblem-symbolic-link-symbolic")
            self.rows.append((icon, self.visible(name), "" if size is None else GLib.format_size(size), name, kind))

    @staticmethod
    def visible(value):
        return "".join(c if c.isprintable() else "\ufffd" for c in value)

    def selected(self):
        model, paths = self.tree.get_selection().get_selected_rows()
        return [model[path][3] for path in paths if model[path][4] in ("file", "directory")]

    def open(self, window, index):
        row = self.rows[index]
        if row[4] == "directory" and self.path:
            window.browse(self.side, os.path.join(self.path, row[3]))

    def drag_data(self, _tree, _context, selection, _info, _time):
        selection.set(selection.get_target(), 8, json.dumps(self.selected(), ensure_ascii=False).encode("utf-8"))


