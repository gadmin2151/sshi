    def edit_notes(self, profile):
        dialog = Gtk.Dialog(title=tr("Заметки", "Notes"), transient_for=self, modal=True, destroy_with_parent=True)
        dialog.set_default_size(530, 340)
        dialog.add_button(tr("Отмена", "Cancel"), Gtk.ResponseType.CANCEL)
        styled(dialog.add_button(tr("Сохранить", "Save"), Gtk.ResponseType.OK), "suggested-action")
        content = box(True, 8)
        content.set_border_width(12)
        content.pack_start(label(profile["name"], "sshi-section", wrap=True), False, False, 0)
        editor = Gtk.TextView(wrap_mode=Gtk.WrapMode.WORD_CHAR, left_margin=8, right_margin=8,
