    def keypress(self, _, event):
        self.reset_clicks()
        card = self.selected_card()
        if card is not None and self.get_focus() == card:
            if event.keyval == Gdk.KEY_F2:
                self.rename(card.profile)
                return True
            if event.keyval in (Gdk.KEY_Return, Gdk.KEY_KP_Enter):
                self.connect_to(card.profile)
                return True
        if event.state & Gdk.ModifierType.CONTROL_MASK:
            if event.keyval in (Gdk.KEY_f, Gdk.KEY_F):
                self.search.grab_focus()
                return True
            if event.keyval in (Gdk.KEY_n, Gdk.KEY_N):
                self.edit()
                return True
        return False

    def rename(self, profile):
        self.reset_clicks()
        def save(name):
            cli("profile", "rename", "--name", profile["name"], "--to", name)
            self.reload(name)
        self.fields(tr("Переименовать подключение", "Rename connection"), [
            (tr("Имя", "Name"), profile["name"], tr("Имя подключения", "Connection name"), False),
        ], save, primary=tr("Переименовать", "Rename"))

    def fields(self, title, rows, submit, remove=None, primary=None, parent=None):
        dialog = Gtk.Dialog(title=title, transient_for=parent or self, modal=True)
        dialog.add_button(tr("Отмена", "Cancel"), Gtk.ResponseType.CANCEL)
        dialog.add_button(primary or tr("Сохранить", "Save"), Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(column_spacing=14, row_spacing=12, margin=20)
        entries = []
        for i, (caption, initial, hint, secret) in enumerate(rows):
            title = label(caption)
            grid.attach(title, 0, i, 1, 1)
            entry = Gtk.Entry(text=initial, placeholder_text=hint, visibility=not secret)
            title.set_mnemonic_widget(entry)
            entry.set_width_chars(38)
            entry.set_activates_default(True)
            grid.attach(entry, 1, i, 1, 1)
            entries.append(entry)
        if remove:
            dialog.add_button(tr("Удалить…", "Delete…"), Gtk.ResponseType.REJECT)
        dialog.get_content_area().add(grid)
        dialog.show_all()
        while True:
            response = dialog.run()
            if response == Gtk.ResponseType.REJECT and remove:
                dialog.destroy()
                self.safe(remove)
                return
            if response != Gtk.ResponseType.OK:
                break
            try:
                submit(*[entry.get_text() for entry in entries])
                break
            except (ValueError, OSError, subprocess.SubprocessError) as error:
                self.message(str(error), True)
        dialog.destroy()

    def edit(self, p=None, initial=None):
        if not p and not initial:
            ConnectionDialog(self).present_form()
            return
        old = p or initial or {}
        def save(name, user, endpoint, relay):
            args = ["profile", "save", "--name", name, "--user", user, "--endpoint", endpoint]
            if p:
                args.extend(["--previous", p["name"]])
            if relay.strip():
                args.extend(["--relay", relay.strip()])
            cli(*args)
            self.reload(name.strip())
        self.fields(tr("Настройки подключения", "Connection settings") if p else tr("Новое подключение", "New connection"), [
            (tr("Имя", "Name"), old.get("name", ""), tr("Рабочий сервер", "Work server"), False),
            (tr("Пользователь SSH", "SSH user"), old.get("user", ""), "user", False),
            ("Endpoint ID", old.get("endpoint", ""), tr("64 символа", "64 characters"), False),
            ("Relay", old.get("relay", ""), tr("Из настроек SSHI", "From SSHI settings"), False),
        ], save, (lambda: self.remove(p)) if p else None)

    def remove(self, p):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.NONE,
                                   message_type=Gtk.MessageType.QUESTION,
                                   text=tr("Удалить подключение «{}»?", "Delete connection “{}”?").format(p["name"]))
        dialog.add_button(tr("Отмена", "Cancel"), Gtk.ResponseType.CANCEL)
        dialog.add_button(tr("Удалить", "Delete"), Gtk.ResponseType.OK)
        answer = dialog.run()
        dialog.destroy()
        if answer == Gtk.ResponseType.OK:
            cli("profile", "remove", "--name", p["name"])
            self.reload()

