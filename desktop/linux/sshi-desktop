        self.submit.set_label(tr("Принять и подключиться", "Accept and connect") if invite else tr("Сохранить", "Save"))
        text = self.code.get_text().strip() if invite else ""
        link = text.startswith("sshi:")
        self.inspected = None
        self.result.set_text("")
        self.result.hide()
        route_widgets = (self.endpoint, self.user, self.relay)
        if link and not self.profile and self.manual_route is None:
            self.manual_route = tuple(w.get_text() for w in route_widgets)
        if link:
            try:
                meta = json.loads(cli("invitation", "inspect", stdin=text + "\n"))
            except (OSError, ValueError, subprocess.SubprocessError):
                self.result.set_text(tr("Вставьте полную ссылку приглашения.", "Paste the complete invitation link."))
            else:
                self.inspected = meta
                if self.profile and (self.profile["endpoint"] != meta["endpoint"] or self.profile["user"] != meta["user"]):
                    self.inspected = None
                    self.result.set_text(tr("Приглашение выдано для другого подключения.",
                                            "This invitation is for a different connection."))
                elif self.profile and meta["relay"]:
                    try:
                        config = json.loads(cli("profile", "run", "--name", self.profile["name"], "--", "config", "show", "--json"))
                        if not self.same_relay(config["relay_url"], meta["relay"]):
                            raise ValueError
                    except (OSError, ValueError, subprocess.SubprocessError):
                        self.inspected = None
                        self.result.set_text(tr("Relay в приглашении отличается от relay сохранённого подключения.",
                                                "The invitation relay differs from the saved connection’s relay."))
            if not self.profile:
                meta = self.inspected or {}
                for widget, key in zip(route_widgets, ("endpoint", "user", "relay")):
                    value = meta.get(key, "")
                    if key == "relay" and not value and self.inspected:
                        value = self.manual_route[2]
                    if widget.get_text() != value:
                        widget.set_text(value)
        elif self.manual_route is not None:
            for widget, value in zip(route_widgets, self.manual_route):
                widget.set_text(value)
            self.manual_route = None
        if self.profile:
            displayed_relay = (self.inspected or {}).get("relay") or self.profile["relay"]
            if self.relay.get_text() != displayed_relay:
                self.relay.set_text(displayed_relay)
        for widget in (self.endpoint, self.user):
            widget.set_editable(not self.profile and not link)
        self.relay.set_editable(not self.profile and (not link or not (self.inspected or {}).get("relay")))
        self.validate()

    @staticmethod
    def same_relay(left, right):
        # A missing root slash and the default HTTP(S) port describe the same relay.
        def parts(text):
            url = urlsplit(text)
            return url.scheme, url.hostname, url.port or {"https": 443, "http": 80}.get(url.scheme), url.path or "/", url.query, url.fragment
        return parts(left) == parts(right)

    def validate(self, *_):
        ep, user = self.endpoint.get_text().strip().lower(), self.user.get_text().strip()
        valid = (re.fullmatch(r"[0-9a-f]{64}", ep) and user and not user.startswith("-")
                 and len(user.encode()) <= 256 and not re.search(r"[\s@\x00-\x1f\x7f-\x9f]", user))
        suggestion = f"{user}@{ep[:12]}" if valid else tr("Необязательно", "Optional")
        if len(suggestion.encode()) > 256:
            suggestion = ep[:12]
        self.name.set_placeholder_text(suggestion)
        name = self.name.get_text().strip() or suggestion
        code = self.code.get_text().strip()
        if self.mode.get_active_id() == "invite":
            valid = valid and (self.inspected is not None or re.fullmatch(r"[0-9a-fA-F]{64}", code))
        self.submit.set_sensitive(bool(valid) and len(name.encode()) <= 256
                                  and not re.search(r"[\x00-\x1f\x7f-\x9f]", name) and not self.pending)

    def start(self):
        if self.pending or not self.submit.get_sensitive():
            return
        code = self.code.get_text().strip()
        ep, user, relay = (e.get_text().strip() for e in (self.endpoint, self.user, self.relay))
        ep = ep.lower()
        name = self.name.get_text().strip() or self.name.get_placeholder_text()
        token = self.token.get_text()
        invite = self.mode.get_active_id() == "invite"
        previously_granted = self.granted_route == (ep, relay)
        self.pending = True
        self.body.set_sensitive(False)
        self.set_response_sensitive(Gtk.ResponseType.CANCEL, False)
        self.validate()
        self.result.set_text(tr("Проверяем приглашение через Iroh…", "Checking invitation over Iroh…") if invite else "")
        def work():
            error = None
            granted = previously_granted
            selected_name = name
            try:
                profiles = json.loads(cli("profile", "list", "--json"))
                current = next((p for p in profiles if p["name"].lower() == name.lower()), None)
                if self.profile:
                    if current != self.profile:
                        raise ValueError(tr("Сохранённое подключение изменилось. Откройте его снова.",
                                            "The saved connection changed. Open it again."))
                elif current and (current["endpoint"], current["user"], current["relay"]) != (ep, user, relay):
                    raise ValueError(tr("Это имя занято другим подключением. Выберите новое имя.",
                                        "Another connection has this name. Choose a different name."))
                if invite and not granted:
                    args = ["invitation", "redeem", "--endpoint", ep]
                    route = ["--relay", relay] if relay else []
                    if token:
                        cli("config", "set-token", *route, stdin=token + "\n")
                    cli(*args, *route, stdin=code + "\n", timeout=45)
                    granted = True
                if current:
                    selected_name = current["name"]
                else:
                    cli("profile", "save", "--name", name, "--endpoint", ep, "--user", user, "--relay", relay)
            except (ValueError, OSError, subprocess.SubprocessError) as exc:
                error = str(exc)
                detail = error.lower()
                if "invitation denied" in detail or "expired" in detail:
                    error = tr("Получатель отклонил приглашение. Скопируйте свой ID, попросите новый код у владельца и вставьте его сюда.",
                               "The receiver declined the invitation. Copy your ID, ask the owner for a fresh code, then paste it here.")
                elif isinstance(exc, subprocess.TimeoutExpired) or any(word in detail for word in (
                        "timed out", "deadline", "connection lost", "failed to connect", "could not connect", "unreachable")):
                    error = tr("Не удалось связаться с получателем. Сверьте его Endpoint ID и адрес relay, затем проверьте, что на нём запущена служба sshi.",
                               "Could not reach the receiver. Check its Endpoint ID and relay address, then check that its sshi service is running.")
            GLib.idle_add(self.finish, selected_name, invite, error, (ep, relay) if granted else None)
        threading.Thread(target=work, daemon=True).start()

    def finish(self, name, invite, error, grant):
        self.pending = False
        self.granted_route = grant
        self.body.set_sensitive(True)
        self.set_response_sensitive(Gtk.ResponseType.CANCEL, True)
        if error:
            self.result.set_text(error)
            self.validate()
        else:
            self.code.set_text("")
            self.token.set_text("")
            self.manager.safe(lambda: self.manager.reload(name))
            self.response(Gtk.ResponseType.CLOSE)
            if invite:
                self.manager.safe(lambda: open_terminal(["connect", name], False))
        return GLib.SOURCE_REMOVE

    def present_form(self):
        while True:
            response = self.run()
            if response == Gtk.ResponseType.OK and not self.pending:
                self.start()
            elif not self.pending:
                break
        self.destroy()


