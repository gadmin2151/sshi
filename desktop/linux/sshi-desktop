    def matches(self, card):
        text = self.search.get_text().strip().casefold()
        profile = card.profile
        return text in profile["name"].casefold() or text in (profile["user"] + "@" + profile["endpoint"]).casefold()

    def selected_card(self):
        return next(iter(self.cards.get_selected_children()), None)

    def filter_cards(self, *_):
        self.reset_clicks()
        self.cards.invalidate_filter()
        visible = [card for card in self.cards.get_children() if card.get_child_visible()]
        if not visible:
            self.cards.unselect_all()
        elif self.selected_card() not in visible:
            self.cards.select_child(visible[0])
        self.card_selected()

    def cancel_rename(self):
        if self.rename_timer:
            GLib.source_remove(self.rename_timer)
            self.rename_timer = 0

    def reset_clicks(self, *_):
        self.cancel_rename()
        self.clicked_card = None
        self.double_click_card = None
        return False

    def card_selected(self, *_):
        card = self.selected_card()
        if card != self.clicked_card:
            self.reset_clicks()
        self.show_profile(card.profile if card else None)

    def focus_changed(self, _, widget):
        if widget != self.clicked_card:
            self.reset_clicks()

    def card_pressed(self, _, count, x, y):
        self.cancel_rename()
        self.press_xy = int(x), int(y)
        self.press_time = GLib.get_monotonic_time() // 1000
        card = self.cards.get_child_at_pos(*self.press_xy)
        self.double_click_card = card if count == 2 and card == self.clicked_card else None

    def card_released(self, _, count, x, y):
        card = self.cards.get_child_at_pos(int(x), int(y))
        if (card is None or card != self.cards.get_child_at_pos(*self.press_xy)
                or self.cards.drag_check_threshold(*self.press_xy, int(x), int(y))):
            self.reset_clicks()
            return
        if count != 1:
            self.clicked_card = None
            return
        delay = self.get_settings().get_property("gtk-double-click-time")
        if (card == self.clicked_card and card == self.selected_card()
                and self.press_time - self.clicked_at > delay):
            # A further press within GTK's double-click interval takes precedence.
            self.rename_timer = GLib.timeout_add(delay, self.rename_after_click, card)
        self.clicked_card = card
        self.clicked_at = self.press_time

    def rename_after_click(self, card):
        self.rename_timer = 0
        if card == self.clicked_card and card == self.selected_card():
            self.rename(card.profile)
        return GLib.SOURCE_REMOVE

    def card_activated(self, _, card):
        event = Gtk.get_current_event()
        if (event and event.type in (Gdk.EventType.BUTTON_PRESS, Gdk.EventType.DOUBLE_BUTTON_PRESS,
                                     Gdk.EventType.BUTTON_RELEASE, Gdk.EventType.TOUCH_BEGIN)
                and self.double_click_card != card):
            return  # GTK counts clicks by location, even across neighboring cards.
        self.reset_clicks()
        self.connect_to(card.profile)

    def reload(self, select=None):
        selected = self.selected_card()
        name = select if select is not None else selected.profile["name"] if selected else None
        data = json.loads(cli("profile", "list", "--json"))
        self.profiles = sorted(data, key=lambda p: p["name"].casefold())
        if select is not None:
            self.search.set_text("")
        for card in self.cards.get_children():
            self.cards.remove(card)
        chosen = None
        for p in self.profiles:
            card = Gtk.FlowBoxChild()
            card.profile = p
            card.set_size_request(218, -1)
            card.get_accessible().set_name(p["name"])
            card.set_tooltip_text(p["name"] + "\n" + p["user"] + "@" + p["endpoint"])
            content = box(False, 12)
            content.set_valign(Gtk.Align.CENTER)
            content.pack_start(self.host_badge(p, 30), False, False, 0)
            info = box(True, 5)
            info.add(label(p["name"], "sshi-host-name"))
            info.add(label(p["user"] + " · " + p["endpoint"][:8] + "…", "sshi-muted", "sshi-mono"))
            content.pack_start(info, True, True, 0)
            card.add(content)
            self.cards.add(card)
            if p["name"] == name:
                chosen = card
        self.cards.show_all()
        if chosen:
            self.cards.select_child(chosen)
        self.filter_cards()

