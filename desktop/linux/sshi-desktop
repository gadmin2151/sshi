    def safe(self, callback):
        try:
            return callback()
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            self.message(str(error), True)
            return None

    def message(self, text, error=False):
        dialog = Gtk.MessageDialog(transient_for=self, modal=True, buttons=Gtk.ButtonsType.NONE,
                                   message_type=Gtk.MessageType.ERROR if error else Gtk.MessageType.INFO,
                                   text=text)
        dialog.add_button(tr("Закрыть", "Close"), Gtk.ResponseType.CLOSE)
        dialog.run()
        dialog.destroy()

    def matches(self, row):
        text = self.search.get_text().casefold()
        return any(text in row.profile[k].casefold() for k in ("name", "user", "endpoint"))

    def filter_rows(self, *_):
        self.reset_clicks()
        self.listbox.invalidate_filter()
        rows = [r for r in self.listbox.get_children() if r.get_child_visible()]
        if self.listbox.get_selected_row() not in rows:
            self.listbox.select_row(rows[0] if rows else None)

    def cancel_rename(self):
        if self.rename_timer:
            GLib.source_remove(self.rename_timer)
            self.rename_timer = 0

    def reset_clicks(self, *_):
        self.cancel_rename()
        self.clicked_row = None
        return False

    def row_selected(self, _, row):
        if row != self.clicked_row:
            self.reset_clicks()
        self.show_profile(row.profile if row else None)

    def focus_changed(self, _, widget):
        if widget != self.clicked_row:
            self.reset_clicks()

    def row_pressed(self, _, count, x, y):
        self.cancel_rename()
        self.press_xy = int(x), int(y)
        self.press_time = GLib.get_monotonic_time() // 1000

    def row_released(self, _, count, x, y):
        row = self.listbox.get_row_at_y(int(y))
        if (count != 1 or row is None or row != self.listbox.get_row_at_y(self.press_xy[1])
                or self.listbox.drag_check_threshold(*self.press_xy, int(x), int(y))):
            self.reset_clicks()
            return
        delay = self.get_settings().get_property("gtk-double-click-time")
        if (row == self.clicked_row and row == self.listbox.get_selected_row()
                and self.press_time - self.clicked_at > delay):
            # A further press within GTK's double-click interval takes precedence.
            self.rename_timer = GLib.timeout_add(delay, self.rename_after_click, row)
        self.clicked_row = row
        self.clicked_at = self.press_time

    def rename_after_click(self, row):
        self.rename_timer = 0
        if row == self.clicked_row and row == self.listbox.get_selected_row():
            self.rename(row.profile)
        return GLib.SOURCE_REMOVE

    def row_activated(self, _, row):
        event = Gtk.get_current_event()
        if (event and event.type in (Gdk.EventType.BUTTON_PRESS, Gdk.EventType.DOUBLE_BUTTON_PRESS,
                                     Gdk.EventType.TOUCH_BEGIN) and self.clicked_row != row):
            return  # Two close presses can land on opposite sides of a row boundary.
        self.reset_clicks()
        self.connect_to(row.profile)

    def reload(self, select=None):
        data = json.loads(cli("profile", "list", "--json"))
        self.profiles = sorted(data, key=lambda p: p["name"].casefold())
        for row in self.listbox.get_children():
            self.listbox.remove(row)
        first, chosen = None, None
        for p in self.profiles:
            row = Gtk.ListBoxRow()
            row.profile = p
            content = styled(box(False, 10), "sshi-row")
            icon = styled(Gtk.Image.new_from_icon_name("network-server-symbolic", Gtk.IconSize.BUTTON),
                          "sshi-profile-icon")
            icon.set_valign(Gtk.Align.CENTER)
            content.add(icon)
            info = box(True, 4)
            info.add(label(p["name"], "sshi-section"))
            info.add(label(p["user"] + "@" + p["endpoint"][:10] + "…", "dim-label", "sshi-mono"))
            content.pack_start(info, True, True, 0)
            row.add(content)
            self.listbox.add(row)
            first = first or row
            if p["name"] == select:
                chosen = row
        self.listbox.show_all()
        if select is not None:
            self.search.set_text("")
        self.listbox.select_row(chosen or first)
        self.filter_rows()
        row = self.listbox.get_selected_row()
        self.show_profile(row.profile if row else None)

