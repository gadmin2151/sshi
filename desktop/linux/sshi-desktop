def styled(widget, *classes):
    for cls in classes:
        widget.get_style_context().add_class(cls)
    return widget


def label(text, *classes, wrap=False):
    item = Gtk.Label(label=text, xalign=0)
    if wrap:
        item.set_line_wrap(True)
        item.set_line_wrap_mode(Pango.WrapMode.WORD_CHAR)
        attributes = Pango.AttrList()
        attributes.insert(Pango.attr_insert_hyphens_new(False))
        item.set_attributes(attributes)
    else:
        item.set_ellipsize(Pango.EllipsizeMode.MIDDLE)
    return styled(item, *classes)


def action(text, callback, icon=None):
    item = styled(Gtk.Button.new_with_label(text), "sshi-control")
    if icon:
        item.set_image(Gtk.Image.new_from_icon_name(icon, Gtk.IconSize.BUTTON))
        item.set_always_show_image(True)
    item.connect("clicked", lambda *_: callback())
    return item


def box(vertical=False, spacing=8):
    return Gtk.Box(orientation=Gtk.Orientation.VERTICAL if vertical else Gtk.Orientation.HORIZONTAL,
                   spacing=spacing)


def cli(*args, stdin=None, timeout=8):
    result = subprocess.run([SSHI, *args], input=stdin, capture_output=True,
                            text=True, timeout=timeout, check=False)
    if result.returncode != 0:
        raise ValueError(result.stderr.strip() or tr("Команда SSHI завершилась с ошибкой.", "The SSHI command failed."))
    return result.stdout.strip()


def background(work, completed):
    def run():
        try:
            value = work()
        except (OSError, ValueError, KeyError, subprocess.SubprocessError) as error:
            GLib.idle_add(completed, None, str(error))
        else:
            GLib.idle_add(completed, value, None)
    threading.Thread(target=run, daemon=True).start()


def open_terminal(args, hold, report_dir=None):
    wrapper = (
        'hold=$1; prompt=$2; shift 2; "$@"; result=$?; '
        'if [ "$hold" = yes ] || { [ "$hold" != never ] && [ "$result" != 0 ]; }; then '
        'printf "\\n%s" "$prompt"; read -r answer; fi; exit "$result"'
    )
    program = [SSHI, *args]
    if report_dir:
        program = [sys.executable, str(Path(__file__).resolve()), "--report-socket-start", str(report_dir), args[-1]]
    keep = "yes" if hold else "never" if report_dir else "on-error"
    command = ["/bin/sh", "-c", wrapper, "sshi-terminal", keep,
               tr("Нажмите Enter, чтобы закрыть окно.", "Press Enter to close this window."), *program]
    launchers = [
        ("x-terminal-emulator", "-e"), ("xdg-terminal-exec",),
        ("ptyxis", "--new-window", "--"), ("kgx", "-e"), ("gnome-terminal", "--window", "--"),
        ("konsole", "--separate", "-e"), ("xfce4-terminal", "--disable-server", "-x"),
        ("alacritty", "-e"), ("xterm", "-e"),
    ]
    for executable, *options in launchers:
        path = shutil.which(executable)
        if path:
            return subprocess.Popen([path, *options, *command], start_new_session=True)
    raise ValueError(tr("Установите эмулятор терминала, например Konsole или xterm.", "Install a terminal emulator such as Konsole or xterm."))


def report_terminal(directory, program):
    # stdin and stdout stay on the real terminal. A second tty mirrors only
    # diagnostics so prompts use /dev/tty and typed passwords are never logged.
    import errno
    import termios
    try:
        directory_fd = os.open(directory, os.O_DIRECTORY | os.O_NOFOLLOW)
        meta = os.fstat(directory_fd)
        if meta.st_uid != os.geteuid() or meta.st_mode & 0o077:
            os.close(directory_fd)
            directory_fd = None
    except FileNotFoundError:
        directory_fd = None  # The user left the view; the login continues.

    def publish(name, content):
        if directory_fd is None:
            return
        # Anchor writes to the original private directory even if the window
        # closed and another process recreated its former name in /tmp.
        try:
            fd = os.open("pending", os.O_WRONLY | os.O_CREAT | os.O_EXCL | os.O_NOFOLLOW,
                         mode=0o600, dir_fd=directory_fd)
            with os.fdopen(fd, "w", encoding="utf-8") as temp:
                temp.write(content)
            os.rename("pending", name, src_dir_fd=directory_fd, dst_dir_fd=directory_fd)
        except FileNotFoundError:
            pass

    publish("started", str(os.getpid()))
    reader, writer = os.openpty()
    tail = bytearray()
    try:
        attrs = termios.tcgetattr(writer)
        attrs[1] &= ~termios.OPOST
        termios.tcsetattr(writer, termios.TCSANOW, attrs)
        try:
            process = subprocess.Popen(program, stderr=writer)
        finally:
            os.close(writer)
        # A detached master might retain stderr. Stop on process completion
        # after draining available bytes, without waiting for its descendants.
        while True:
            running = process.poll() is None
            if not select.select([reader], [], [], 0.15 if running else 0)[0]:
                if running:
                    continue
                break
            try:
                chunk = os.read(reader, 8192)
            except OSError as error:
                if error.errno != errno.EIO:
                    raise
                break  # All slave tty descriptors have been closed.
            if not chunk:
                break
            os.write(2, chunk)
            tail[:] = (tail + chunk)[-4096:]
        code = process.wait()
    except OSError as error:
        code = 1
        tail.extend(str(error).encode())
        print(error, file=sys.stderr)
    except KeyboardInterrupt:
        code = 130
    finally:
        os.close(reader)
    detail = ""
    if code:
        clean = re.sub(r"\x1b\[[0-?]*[ -/]*[@-~]", "", tail.decode(errors="replace"))
        detail = "".join(c for c in clean if c.isprintable() or c in "\n\t").strip()
    try:
        publish("result.json", json.dumps([code, detail]))
    finally:
        if directory_fd is not None:
            os.close(directory_fd)
    return code if code >= 0 else 128 - code


def socket_address(host, port):
    host, port = host.strip(), port.strip()
    digits = port.lstrip("0")
    if not re.fullmatch(r"[0-9]+", port) or not digits or len(digits) > 5 or int(digits) > 65535:
        raise ValueError(tr("Укажите порт от 1 до 65535.", "Enter a port from 1 to 65535."))
    literal = host[1:-1] if host.startswith("[") and host.endswith("]") else host
    try:
        ipv6 = ":" in literal and "%" not in literal and ipaddress.IPv6Address(literal)
    except ValueError:
        ipv6 = False
    if ipv6:
        return f"[{literal}]:{port}"
    dns = host.removesuffix(".")
    # An IPv4-shaped address must also be a valid IPv4 literal.
    if re.fullmatch(r"[0-9]+(?:\.[0-9]+){3}", dns):
        try:
            ipaddress.IPv4Address(dns)
        except ValueError:
            dns = ""
    if len(dns) > 253 or not all(re.fullmatch(r"[a-zA-Z0-9](?:[a-zA-Z0-9-]{0,61}[a-zA-Z0-9])?", part)
                                 for part in dns.split(".")):
        raise ValueError(tr("Укажите IP-адрес или имя хоста.", "Enter an IP address or hostname."))
    return f"{host}:{port}"


class ControlSocketPanel(Gtk.Box):
    def __init__(self, profile, errors, on_active=None):
        super().__init__(orientation=Gtk.Orientation.VERTICAL, spacing=8)
        self.get_style_context().add_class("sshi-card")
        self.name = profile["name"]
        self.cache_key = (profile["user"], profile["endpoint"], profile.get("relay", ""))
        self.errors = errors
        self.on_active = on_active
        self.phase = "loading"
        self.active = False
        self.checking = False
        self.generation = 0
        self.confirming = False
        self.disposed = False
        self.report = None
        self.last_check = 0
        self.terminal_retry = bool(errors.get(self.cache_key))
        self.connect("destroy", self.dispose)

        heading = box(False, 8)
        heading.pack_start(label(tr("SSH-сокет", "SSH control socket"), "sshi-section"), False, False, 0)
        self.status = styled(label(""), "sshi-socket-state")
        heading.pack_start(self.status, False, False, 0)
        self.pack_start(heading, False, False, 0)

        row = box(False, 6)
        self.start_button = styled(action(tr("Включить", "Enable"), self.start), "suggested-action")
        self.terminal_button = action(tr("Войти в терминале…", "Sign in via terminal…"), self.start_terminal)
        self.copy_button = action(tr("Скопировать команду", "Copy command"), lambda: self.copy("command"), "edit-copy-symbolic")
        self.path_button = action(tr("Путь", "Path"), lambda: self.copy("path"))
        self.path_button.set_tooltip_text(tr("Скопировать путь к сокету", "Copy socket path"))
        self.stop_button = action(tr("Остановить…", "Stop socket…"), lambda: self.confirm_stop(True))
        self.confirm_button = styled(action(tr("Остановить", "Stop"), self.stop), "destructive-action")
        self.cancel_button = action(tr("Отмена", "Cancel"), lambda: self.confirm_stop(False))
        for button in (self.start_button, self.terminal_button, self.copy_button, self.path_button,
                       self.stop_button, self.confirm_button, self.cancel_button):
            button.set_no_show_all(True)
            row.pack_start(button, False, False, 0)
        self.pack_start(row, False, False, 0)
        self.feedback = label("", "dim-label", wrap=True)
        self.feedback.set_no_show_all(True)
        self.pack_start(self.feedback, False, False, 0)

        self.details = Gtk.Expander(label=tr("Ошибка сокета", "Socket error"))
        self.details.set_no_show_all(True)
        self.detail_text = label("", "sshi-mono", wrap=True)
        self.detail_text.set_selectable(True)
        self.details.add(self.detail_text)
        self.pack_start(self.details, False, False, 0)

        self.show_all()
        self.detail_text.show()
        self.render()
        self.timer = GLib.timeout_add_seconds(1, self.poll)
        self.check()

    def render(self):
        idle = self.phase == "idle"
        states = {
            "loading": tr("Проверяем…", "Checking…"),
            "starting": tr("Включаем…", "Starting…"),
            "stopping": tr("Останавливаем…", "Stopping…"),
            "terminal": tr("Вход в терминале…", "Signing in via terminal…"),
            "idle": tr("Включён", "On") if self.active else tr("Выключен", "Off"),
        }
        self.status.set_text(states[self.phase])
        style = self.status.get_style_context()
        if self.active and idle:
            style.add_class("sshi-socket-on")
        else:
            style.remove_class("sshi-socket-on")
        self.start_button.set_visible(idle and not self.active)
        self.terminal_button.set_visible(idle and not self.active and self.terminal_retry)
        self.copy_button.set_visible(idle and self.active and not self.confirming)
        self.path_button.set_visible(idle and self.active and not self.confirming)
        self.stop_button.set_visible(idle and self.active and not self.confirming)
        self.confirm_button.set_visible(idle and self.active and self.confirming)
        self.cancel_button.set_visible(idle and self.active and self.confirming)
        details = self.errors.get(self.cache_key, "")
        self.detail_text.set_text(details)
        self.details.set_visible(bool(details))

    def feedback_text(self, value):
        self.feedback.set_text(value)
        self.feedback.set_visible(bool(value))

    def show_error(self, detail):
        self.errors[self.cache_key] = detail
        self.details.set_expanded(True)
        self.render()

    def set_active(self, active):
        changed = self.active != active
        self.active = active
        self.phase = "idle"
        if not active:
            self.confirming = False
            if changed:
                self.feedback_text("")
        else:
            self.errors.pop(self.cache_key, None)
            self.terminal_retry = False
        self.render()
        if changed and active and self.on_active:
            self.on_active()

    def copy(self, kind):
        def finished(value, error):
            if self.disposed:
                return
            if error:
                self.show_error(error)
            elif self.active:
                clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
                clipboard.set_text(value, -1)
                clipboard.store()
                self.feedback_text(tr("Скопировано.", "Copied."))
        background(lambda: cli("socket", kind, "--", self.name), finished)

    def confirm_stop(self, confirming):
        self.confirming = confirming
        self.feedback_text(tr("Сеансы через этот сокет завершатся.", "Sessions using this socket will disconnect.") if confirming else "")
        self.render()

    def start(self):
        if self.phase != "idle" or self.active:
            return
        self.begin("starting")

        def finished(_, error):
            if self.disposed:
                return
            self.phase = "idle"
            if error:
                self.terminal_retry = True
                self.show_error(error)
            else:
                self.set_active(True)
        background(lambda: cli("socket", "start", "--batch", "--", self.name, timeout=45), finished)

    def stop(self):
        if not self.confirming or not self.active:
            return
        self.begin("stopping")

        def finished(_, error):
            if self.disposed:
                return
            self.phase = "idle"
            self.confirming = False
            if error and "no active ssh control socket" not in error.lower():
                self.show_error(error)
            else:
                self.set_active(False)
        background(lambda: cli("socket", "close", "--", self.name), finished)

    def begin(self, phase):
        self.generation += 1
        self.phase = phase
        self.errors.pop(self.cache_key, None)
        self.feedback_text("")
        self.render()

    def start_terminal(self):
        if self.phase not in ("idle", "loading") or self.active:
            return
        self.begin("terminal")
        try:
            self.report = tempfile.TemporaryDirectory(prefix="sshi-start-")
            self.started_at = time.monotonic()
            self.launcher = open_terminal(["socket", "start", "--", self.name], False, self.report.name)
        except (OSError, ValueError, subprocess.SubprocessError) as error:
            self.terminal_failed(str(error))

    def terminal_failed(self, detail):
        self.clean_report()
        self.phase = "idle"
        self.terminal_retry = True
        self.show_error(detail)

    def clean_report(self):
        if self.report:
            self.report.cleanup()
            self.report = None

    def poll(self):
        if self.report:
            try:
                outcome = self.start_result()
                if outcome is not None:
                    code, detail = outcome
                    self.clean_report()
                    if code == 0:
                        self.set_active(True)
                    else:
                        self.terminal_failed(detail or tr("SSH завершился с кодом {}.", "SSH exited with status {}.").format(code))
                elif time.monotonic() - self.started_at >= 180:
                    self.terminal_failed(tr("Истекло время ожидания входа в терминале.", "Timed out waiting for sign-in in the terminal."))
            except (OSError, ValueError) as error:
                self.terminal_failed(str(error))
        if not self.disposed and time.monotonic() - self.last_check >= 5:
            self.check()
        return GLib.SOURCE_REMOVE if self.disposed else GLib.SOURCE_CONTINUE

    def check(self):
        if self.phase not in ("idle", "loading") or self.checking or self.disposed:
            return
        self.checking = True
        self.last_check = time.monotonic()
        generation = self.generation

        def finished(_, error):
            self.checking = False
            if self.disposed or generation != self.generation:
                return
            if error and "no active ssh control socket" not in error.lower():
                self.phase = "idle"
                self.show_error(error)
            else:
                self.set_active(not error)
        background(lambda: cli("socket", "check", "--", self.name), finished)

    def dispose(self, *_):
        self.disposed = True
        GLib.source_remove(self.timer)
        self.clean_report()

    def start_result(self):
        directory = Path(self.report.name)
        try:
            return json.loads((directory / "result.json").read_text(encoding="utf-8"))
        except FileNotFoundError:
            pass
        marker = directory / "started"
        if marker.exists():
            pid = marker.read_text().strip()
            if pid:
                try:
                    os.kill(int(pid), 0)
                except ProcessLookupError:
                    # It may have published its result between our two reads.
                    result = directory / "result.json"
                    if result.exists():
                        return json.loads(result.read_text())
                    return 1, tr("Окно терминала закрылось до завершения SSH.", "The terminal closed before SSH finished.")
            return None
        if self.launcher.poll() not in (None, 0) or time.monotonic() - self.started_at >= 15:
            return 1, tr("Терминал не запустил команду SSHI.", "The terminal did not start the SSHI command.")
        return None


