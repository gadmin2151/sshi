    def check_updates(self):
        if self.checking_update:
            return
        self.checking_update = True
        self.update_error = None
        self.refresh_update_ui()
        def finished(info, error):
            self.checking_update = False
            self.update_error = error
            if info:
                self.update_info = info
            self.refresh_update_ui()
        background(lambda: json.loads(cli("update", "--json", timeout=30)), finished)

    def refresh_update_ui(self):
        info = self.update_info
        available = bool(info and info["available"])
        if available:
            self.update_badge.set_label(tr("Обновить до {}", "Update to {}").format(info["latest"]))
        self.update_badge.set_visible(available)
        if self.update_settings is None:
            return
        check, download, summary = self.update_settings
        check.set_sensitive(not self.checking_update)
        download.set_visible(available)
        if self.checking_update:
            message = tr("Проверяем GitHub Releases…", "Checking GitHub Releases…")
        elif self.update_error:
            message = tr("Не удалось проверить обновления.", "Could not check for updates.") + "\n" + self.update_error
        elif available:
            message = tr("Установлена версия {}. Доступна {}.", "Version {} is installed. Version {} is available.").format(info["current"], info["latest"])
        elif info:
            message = tr("Установлена актуальная версия {}.", "Version {} is up to date.").format(info["current"])
        else:
            message = ""
        summary.set_text(message)
        summary.set_visible(bool(message))

    def offer_update(self, parent):
        info = self.update_info
        if not info or not info["available"]:
            return
        asset = info.get("download_url")
        message = tr("Скачать SSHI {}?", "Download SSHI {}?").format(info["latest"])
        dialog = Gtk.MessageDialog(transient_for=parent, modal=True, buttons=Gtk.ButtonsType.NONE,
                                   message_type=Gtk.MessageType.INFO, text=message)
        hint = tr("Откройте скачанный пакет в установщике программ, установите обновление и перезапустите SSHI.",
                  "Open the downloaded package in your software installer, install the update, and restart SSHI.")
        if asset and asset.endswith(".pkg.tar.zst"):
            filename = asset.rsplit("/", 1)[-1]
            hint = tr("В каталоге загрузки выполните команду и перезапустите SSHI.",
                      "In your downloads folder, run this command and restart SSHI.") + "\n\nsudo pacman -U ./" + filename
        elif not asset:
            hint = tr("Выберите пакет для вашей системы на странице релиза. ", "Choose the package for your system on the release page. ") + hint
        dialog.format_secondary_text(hint)
        dialog.add_buttons(tr("Отмена", "Cancel"), Gtk.ResponseType.CANCEL,
                           tr("Скачать пакет", "Download package") if asset else tr("Открыть релиз", "Open release"), Gtk.ResponseType.OK)
        accepted = dialog.run() == Gtk.ResponseType.OK
        dialog.destroy()
        if accepted:
            try:
                Gtk.show_uri_on_window(parent, asset or info["release_url"], Gdk.CURRENT_TIME)
            except GLib.Error as error:
                self.message(str(error), True)

    def settings(self):
        dialog = Gtk.Dialog(title=tr("Настройки", "Settings"), transient_for=self, modal=True)
        dialog.add_buttons(tr("Отмена", "Cancel"), Gtk.ResponseType.CANCEL,
                           tr("Сохранить", "Save"), Gtk.ResponseType.OK)
        dialog.set_default_response(Gtk.ResponseType.OK)
        grid = Gtk.Grid(column_spacing=16, row_spacing=14, margin=20)
        dialog.get_content_area().add(grid)
        language_picker = Gtk.ComboBoxText()
        language_picker.append("ru", "Русский")
        language_picker.append("en", "English")
        language_picker.set_active_id(language)
        caption = label(tr("Язык приложения", "Application language"))
        caption.set_mnemonic_widget(language_picker)
        grid.attach(caption, 0, 0, 1, 1)
        grid.attach(language_picker, 1, 0, 1, 1)
        relay = action(tr("Настройки relay…", "Relay settings…"), lambda: self.safe(lambda: self.relay_settings(dialog)),
                       "network-server-symbolic")
        grid.attach(relay, 0, 1, 2, 1)
        release = Gtk.LinkButton.new_with_label(RELEASE_URL, tr("Что нового в 0.5.0", "What’s new in 0.5.0"))
        release.set_halign(Gtk.Align.START)
        grid.attach(release, 0, 2, 2, 1)
        check = action(tr("Проверить обновления", "Check for updates"), self.check_updates)
        download = action(tr("Обновить…", "Update…"), lambda: self.offer_update(dialog))
        summary = label("", wrap=True)
        summary.set_max_width_chars(52)
        grid.attach(check, 0, 3, 1, 1)
        grid.attach(download, 1, 3, 1, 1)
        grid.attach(summary, 0, 4, 2, 1)
        self.update_settings = (check, download, summary)
        dialog.show_all()
        self.refresh_update_ui()
        accepted = dialog.run() == Gtk.ResponseType.OK
        selected = language_picker.get_active_id()
        self.update_settings = None
        dialog.destroy()
        if accepted and selected != language:
            save_language(selected)
            self.refresh_language()

    def relay_settings(self, dialog):
        current = json.loads(cli("config", "show", "--json"))
        def save(relay, token):
            if token:
                cli("config", "set-token", "--relay", relay, stdin=token + "\n")
            if relay != (current.get("relay_url") or ""):
                cli("config", "set-relay", relay)
        self.fields(tr("Настройки relay", "Relay settings"), [
            (tr("Relay по умолчанию", "Default relay"), current.get("relay_url") or "", "https://relay.example.org/", False),
            (tr("Заменить токен", "Replace token"), "", tr("Оставить текущий", "Keep current token"), True),
        ], save, parent=dialog)

    def profile_token(self, p):
        def save(token):
            args = ["config", "set-token"]
            if p["relay"]:
                args.extend(["--relay", p["relay"]])
            cli(*args, stdin=token + "\n")
        self.fields(tr("Токен relay", "Relay token"), [
            (tr("Новый токен", "New token"), "", p["relay"] or tr("Relay из настроек SSHI", "Relay from SSHI settings"), True),
        ], save)

    def history(self):
        recent = cli("list").splitlines()
        if not recent:
            self.message(tr("История пока пуста. Здесь появятся успешные SSH-подключения.", "Successful SSH connections will appear here."))
            return
        dialog = Gtk.Dialog(title=tr("Недавние подключения", "Recent connections"), transient_for=self, modal=True)
        dialog.add_buttons(tr("Отмена", "Cancel"), Gtk.ResponseType.CANCEL, tr("Сохранить как профиль…", "Save as connection…"), Gtk.ResponseType.OK)
        listed = Gtk.ListBox()
        for destination in recent:
            row = Gtk.ListBoxRow()
            row.destination = destination
            text = label(destination, "sshi-mono", "sshi-row")
            text.set_tooltip_text(destination)
            row.add(text)
            listed.add(row)
        scroll = Gtk.ScrolledWindow()
        scroll.set_size_request(480, 270)
        scroll.add(listed)
        dialog.get_content_area().add(scroll)
        listed.select_row(listed.get_row_at_index(0))
        dialog.show_all()
        accepted = dialog.run() == Gtk.ResponseType.OK
        row = listed.get_selected_row()
        destination = row.destination if row is not None else None
        dialog.destroy()
        if accepted and destination:
            user, endpoint = destination.rsplit("@", 1)
            self.edit(initial={"user": user, "endpoint": endpoint})

    def connect_to(self, p):
        self.safe(lambda: open_terminal(["connect", p["name"]], False))

    def run_profile(self, p, args):
        self.safe(lambda: open_terminal(["profile", "run", "--name", p["name"], "--", *args], True))

    def invite(self, p):
        def issue(client, owner):
            args = ["issue-invite", "--share", "--name", p["name"], "--client", client]
            if owner:
                args.extend(["--service-user", owner])
            open_terminal(args, True)
        self.fields(tr("Создать приглашение", "Create invite"), [
            (tr("Endpoint ID нового ПК", "New computer’s Endpoint ID"), "", tr("64 символа", "64 characters"), False),
            (tr("Пользователь службы", "Service user"), "", p["user"], False),
        ], issue, primary=tr("Создать", "Create"))

    def invite_local(self, parent=None):
        def issue(client, user):
            link = cli("invite", client.strip(), "--share", "--user", user.strip())
            result = Gtk.Dialog(title=tr("Приглашение готово", "Invitation ready"),
                                transient_for=parent or self, modal=True)
            result.add_buttons(tr("Готово", "Done"), Gtk.ResponseType.CLOSE)
            body = box(True, 12)
            body.set_border_width(18)
            result.get_content_area().add(body)
            body.add(label(tr("Отправьте ссылку владельцу приглашённого компьютера. Она действует 10 минут.",
                              "Send the link to the invited computer’s owner. It is valid for 10 minutes."), wrap=True))
            feedback = label("")
            def copy():
                clipboard = Gtk.Clipboard.get(Gdk.SELECTION_CLIPBOARD)
                clipboard.set_text(link, -1)
                clipboard.store()
                feedback.set_text(tr("Ссылка скопирована.", "Link copied."))
            body.add(action(tr("Скопировать приглашение", "Copy invitation"), copy, "edit-copy-symbolic"))
            body.add(feedback)
            result.show_all()
            result.run()
            result.destroy()
        self.fields(tr("Пригласить на этот компьютер", "Invite to this computer"), [
            (tr("Endpoint ID гостя", "Guest Endpoint ID"), "", tr("ID компьютера гостя", "The guest computer’s ID"), False),
            (tr("Пользователь SSH", "SSH user"), getpass.getuser(), "", False),
        ], issue, primary=tr("Создать приглашение", "Create invitation"), parent=parent)

    def ssh_key(self, p):
        def install(path):
            args = ["copy-id"]
            if path:
                args.extend(["-i", os.path.expanduser(path)])
            self.run_profile(p, [*args, p["user"] + "@" + p["endpoint"]])
        self.fields(tr("Установить SSH-ключ", "Install SSH key"), [
            (tr("Публичный ключ", "Public key"), "", "~/.ssh/id_ed25519.pub", False),
        ], install, primary=tr("Установить", "Install"))

    def forward(self, p):
        dialog = ForwardDialog(self, p)
        accepted = dialog.run() == Gtk.ResponseType.OK
        command = dialog.command
        dialog.destroy()
        if accepted and command:
            self.safe(lambda: open_terminal(command, False))

    def backup(self, restore):
        dialog = Gtk.FileChooserDialog(
            title=tr("Импорт подключений", "Import connections") if restore else tr("Экспорт подключений", "Export connections"), transient_for=self,
            action=Gtk.FileChooserAction.OPEN if restore else Gtk.FileChooserAction.SAVE)
        dialog.add_buttons(tr("Отмена", "Cancel"), Gtk.ResponseType.CANCEL,
                           tr("Импортировать", "Import") if restore else tr("Сохранить", "Save"), Gtk.ResponseType.OK)
        if not restore:
            dialog.set_current_name("sshi-connections.json")
        accepted = dialog.run() == Gtk.ResponseType.OK
        path = dialog.get_filename()
        dialog.destroy()
        if accepted and path:
            cli("restore" if restore else "backup", path)
            if restore:
                self.reload()
            self.message(tr("Подключения импортированы.", "Connections imported.") if restore else tr("Резервная копия сохранена.", "Backup saved."))


def main():
    css = Gtk.CssProvider()
    css.load_from_data(STYLE)
    Gtk.StyleContext.add_provider_for_screen(Gdk.Screen.get_default(), css,
                                            Gtk.STYLE_PROVIDER_PRIORITY_APPLICATION)
    window = Window()
    window.show_all()
    if "--smoke-test" in sys.argv:
        while Gtk.events_pending():
            Gtk.main_iteration()
        if not window.get_mapped():
            raise RuntimeError("SSHI window was not mapped")
        print("SSHI native window ready")
        window.destroy()
    else:
        def periodic_check():
            window.check_updates()
            return GLib.SOURCE_CONTINUE
        window.check_updates()
        GLib.timeout_add_seconds(6 * 60 * 60, periodic_check)
        Gtk.main()


if __name__ == "__main__":
    if len(sys.argv) == 4 and sys.argv[1] == "--report-socket-start":
        sys.exit(report_terminal(sys.argv[2], [SSHI, "socket", "start", "--", sys.argv[3]]))
    main()
