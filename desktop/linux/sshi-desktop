        port_title.set_mnemonic_widget(port)
        form.attach(port, 1, row + 1, 1, 1)
        return caption, host, port, (caption, host, port_title, port)

    def change_kind(self, *_):
        kind = self.kind.get_active_id()
        old_default = "1080" if self.previous_kind == "dynamic" else "8080"
        if self.bind_port.get_text() == old_default:
            self.bind_port.set_text("1080" if kind == "dynamic" else "8080")
        self.previous_kind = kind
        self.update()

    def update(self, *_):
        kind = self.kind.get_active_id()
        remote, dynamic = kind == "remote", kind == "dynamic"
        listener = self.profile["name"] if remote else tr("Этот компьютер", "This computer")
        service = tr("Этот компьютер", "This computer") if remote else self.profile["name"]
        self.bind_caption.set_text(tr("Принимать подключения · {}", "Listen for connections · {}").format(listener))
        self.target_caption.set_text(tr("Адрес сервиса · {}", "Service address · {}").format(service))
        for host, port, caption in ((self.bind_host, self.bind_port, self.bind_caption),
                                    (self.target_host, self.target_port, self.target_caption)):
            host.get_accessible().set_name(caption.get_text())
            port.get_accessible().set_name(tr("Порт · ", "Port · ") + caption.get_text())
        for widget in self.target_widgets:
            widget.set_visible(not dynamic)
        for lane, arrow in self.arrows:
            arrow.set_text("◀" if remote else "▶")
            lane.set_direction(Gtk.TextDirection.RTL if remote else Gtk.TextDirection.LTR)

        self.command = None
        listen, target, error = "—", "—", ""
        try:
            listen = socket_address(self.bind_host.get_text(), self.bind_port.get_text())
        except ValueError as exc:
            error = tr("Приём подключений. ", "Listener. ") + str(exc)
        if not dynamic:
            try:
                target = socket_address(self.target_host.get_text(), self.target_port.get_text())
            except ValueError as exc:
                error = error or (tr("Адрес сервиса. ", "Service address. ") + str(exc))
        roles = [(tr("SOCKS5-прокси", "SOCKS5 proxy") if dynamic else tr("Слушает", "Listens"), listen),
                 (tr("Открывает сервис", "Reaches service"),
                  tr("Из запроса SOCKS", "From SOCKS request") if dynamic else target)]
        for (role, detail), (text, address) in zip(self.ends, reversed(roles) if remote else roles):
            role.set_text(text)
            detail.set_text(address)
            detail.set_tooltip_text(address)
        self.set_response_sensitive(Gtk.ResponseType.OK, not error)
        style = self.summary.get_style_context()
        if error:
            style.add_class("error")
            self.summary.set_text(error)
            return
        style.remove_class("error")
        open_address = listen
        host = self.bind_host.get_text().strip().strip("[]")
        try:
            ip = ipaddress.ip_address(host)
            if ip.is_unspecified:
                open_address = socket_address("::1" if ip.version == 6 else "127.0.0.1", self.bind_port.get_text())
        except ValueError:
            pass
        if remote:
            message = tr("На «{}» подключитесь к {}.", "On “{}”, connect to {}.").format(listener, open_address)
        elif dynamic:
            message = tr("В настройках приложения на этом компьютере укажите SOCKS5-прокси {}.",
                         "Set the SOCKS5 proxy in your app on this computer to {}.").format(open_address)
        else:
            message = tr("На этом компьютере подключитесь к {}.", "On this computer, connect to {}.").format(open_address)
        self.summary.set_text(message)
        self.command = ["forward", "--profile", self.profile["name"], "--kind", kind,
                        "--bind-host", self.bind_host.get_text().strip(), "--bind-port", self.bind_port.get_text().strip()]
        if not dynamic:
            self.command.extend(["--target-host", self.target_host.get_text().strip(),
                                 "--target-port", self.target_port.get_text().strip()])


